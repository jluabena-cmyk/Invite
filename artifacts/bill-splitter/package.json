{
  "name": "@workspace/bill-splitter",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eas-build-pre-install": "node --version && echo 'Package manager:' && (pnpm --version 2>/dev/null && echo pnpm || (npm --version && echo npm)) && ls -la && echo 'package.json deps:' && node -e \"const p=require('./package.json'); console.log(JSON.stringify(Object.keys({...p.dependencies,...p.devDependencies}), null, 2))\"",
    "eas-build-post-install": "node scripts/patch-spm.js",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
