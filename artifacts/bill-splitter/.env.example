# ─── API & Deep Links ────────────────────────────────────────────────────────
# The production domain for the deployed API server (no protocol, no trailing slash).
# Used for:
#   - API base URL (https://<domain>/api/...)
#   - Universal link host in iOS associatedDomains and Android intentFilters
#   - expo-router origin for universal links
#   - Privacy policy URL (https://<domain>/api/privacy)
#
# Example: EXPO_PUBLIC_DOMAIN=invite.app
EXPO_PUBLIC_DOMAIN=

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Clerk publishable key for the app's Clerk instance.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: Clerk proxy URL if routing auth requests through your own domain.
# EXPO_PUBLIC_CLERK_PROXY_URL=

# ─── EAS Build ────────────────────────────────────────────────────────────────
# EAS project ID from https://expo.dev — set in app.config.js via this var.
# EAS_PROJECT_ID=
