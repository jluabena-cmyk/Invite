modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scan-error-summary-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "stage-dry-run"

[[workflows.workflow]]
name = "scan-error-summary-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && pnpm test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "stage-dry-run"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/bill-splitter && bash scripts/stage-eas-build.sh --dry-run"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 19339
externalPort = 3001

[[ports]]
localPort = 22252
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 22253
externalPort = 3002

[nix]
channel = "stable-25_05"

